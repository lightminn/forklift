# The IPROPI protection record gate (motor output design 2), run with cmake -P at configure time
# and before every build of an output build:
#   -DSRC_DIR=<a directory in the firmware's git repository> -DRECORD=<record path> -DOUT=<header>
# The record must be a regular file in that repository, committed (its HEAD blob exists), with
# the index equal to HEAD and the work-tree bytes hashing to the HEAD blob; the marker line and the
# hash are read from the HEAD blob's bytes. Writing and committing that record is the user's decision
# (lead decision Q6); building this code is not.

function(refuse why)
    message(FATAL_ERROR "IPROPI protection record: ${why}. FW_MOTOR_OUTPUT=1 needs a committed record "
        "(FW_IPROPI_PROTECTION_RECORD). Opening the motor outputs on the vehicle is the user's "
        "decision after the IPROPI protection is confirmed (lead decision Q6); being able to build "
        "this code is not that decision.")
endfunction()

function(git_ok out)
    execute_process(COMMAND git ${ARGN} WORKING_DIRECTORY ${TOP} RESULT_VARIABLE rc
                    OUTPUT_QUIET ERROR_QUIET)
    if(rc EQUAL 0)
        set(${out} TRUE PARENT_SCOPE)
    else()
        set(${out} FALSE PARENT_SCOPE)
    endif()
endfunction()

if(NOT RECORD)
    refuse("no record given")
endif()
execute_process(COMMAND git rev-parse --show-toplevel WORKING_DIRECTORY ${SRC_DIR}
                OUTPUT_VARIABLE TOP RESULT_VARIABLE rc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT rc EQUAL 0 OR NOT TOP)
    refuse("the firmware sources are not in a git repository")
endif()
if(IS_ABSOLUTE "${RECORD}")
    file(RELATIVE_PATH REL "${TOP}" "${RECORD}")
else()
    set(REL "${RECORD}")
endif()
if(REL MATCHES "^\\.\\./" OR REL STREQUAL ".." OR IS_ABSOLUTE "${REL}")
    refuse("'${RECORD}' is outside the repository")
endif()
set(ABS "${TOP}/${REL}")
if(IS_SYMLINK "${ABS}")
    refuse("'${REL}' is a symbolic link")
endif()
if(NOT EXISTS "${ABS}" OR IS_DIRECTORY "${ABS}")
    refuse("'${REL}' is not a file")
endif()
git_ok(in_head cat-file -e "HEAD:${REL}")
if(NOT in_head)
    refuse("'${REL}' is not committed")
endif()
git_ok(index_clean diff --cached --quiet HEAD -- "${REL}")
# The work-tree bytes are hashed directly: git diff skips a file marked assume-unchanged or
# skip-worktree (Codex code review), so it cannot vouch for the file the build reads.
execute_process(COMMAND git rev-parse "HEAD:${REL}" WORKING_DIRECTORY ${TOP}
                OUTPUT_VARIABLE HEAD_ID OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
execute_process(COMMAND git hash-object --no-filters -- "${ABS}" WORKING_DIRECTORY ${TOP}
                OUTPUT_VARIABLE TREE_ID OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT index_clean OR NOT HEAD_ID OR NOT TREE_ID STREQUAL HEAD_ID)
    refuse("'${REL}' differs from its committed version")
endif()
execute_process(COMMAND git show "HEAD:${REL}" WORKING_DIRECTORY ${TOP} OUTPUT_VARIABLE BLOB
                RESULT_VARIABLE rc ERROR_QUIET)
if(NOT rc EQUAL 0)
    refuse("'${REL}' could not be read from HEAD")
endif()
set(MARK "IPROPI protection record: confirmed-by=[^;\n]+; date=[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]; evidence=[^\n]+")
if(NOT BLOB MATCHES "(^|\n)${MARK}")
    refuse("'${REL}' has no marker line 'IPROPI protection record: confirmed-by=...; date=YYYY-MM-DD; evidence=...'")
endif()
string(SHA256 HASH "${BLOB}")
string(SUBSTRING "${HASH}" 0 8 SHA8)
set(TEXT "/* Generated by check_protection_record.cmake (motor output design 2). */\n#define FW_RECORD_TAG \" rec=${SHA8}\"\n")
if(EXISTS "${OUT}")
    file(READ "${OUT}" OLD)
endif()
if(NOT OLD STREQUAL TEXT)
    file(WRITE "${OUT}" "${TEXT}")
endif()
