<?xml version="1.0"?>
<package format="3">
  <name>forklift_ros</name><version>0.1.0</version>
  <description>Synthetic Gazebo sensor observation validation</description>
  <maintainer email="noreply@example.com">Forklift team</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend><exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_msgs</exec_depend><exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rosbag2_py</exec_depend><exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>python3-numpy</exec_depend><exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-pil</exec_depend><test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
