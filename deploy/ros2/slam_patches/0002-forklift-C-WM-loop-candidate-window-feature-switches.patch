-// Prints the identification line once to stderr: "forklift_slam_patch series=<id> trace=<0|1>".
+// Prints the identification line once to stderr:
+// "forklift_slam_patch series=<id> trace=<0|1> cwm_s=<T> delete_s=<T> s1=<0|1> s1_buffer=<B>".
+// More than one feature on at once is refused here (the node exits; design v3 2).
 void announce();
 
+// The features run in a fresh sync mapping only (design v3 2): a lifelong, localization, async or map-and-localization
+// node, or a mapper loaded from a serialized graph, ends the node when any feature is on.
+void refuse_unless_fresh_sync_mapping(const char * where);
+
+// C-WM's window start: the first id in [0, n) whose scan time is >= threshold, the times nondecreasing in id.
+// time_of(id) returns no value for an id with no scan -- a broken premise (no deletion, ids contiguous): -2.
+template<class TimeOf>
+long window_start(long n, double threshold, TimeOf time_of)
+{
+  long lo = 0, hi = n;  // the answer is in [lo, hi]; hi == n: no id in the window
+  while (lo < hi) {
+    const long mid = lo + (hi - lo) / 2;
+    const std::optional<double> t = time_of(mid);
+    if (!t) {
+      return -2;
+    }
+    if (*t >= threshold) {
+      hi = mid;
+    } else {
+      lo = mid + 1;
+    }
+  }
+  return lo;
+}
+
 // True when the trace is on; a timer or a counter does nothing (not even read a clock) when it is off.
 bool tracing();
 
