-  std::string trace;  // FORKLIFT_SLAM_TRACE: the trace file ('' = off)
+  std::string trace;      // FORKLIFT_SLAM_TRACE: the trace file ('' = off)
+  double cwm_s = 0.0;     // FORKLIFT_SLAM_CWM_S: C-WM, loop candidates only from the last T sim seconds (<= 0 off)
+  double delete_s = 0.0;  // FORKLIFT_SLAM_DELETE_OLDER_S: C, nodes older than T sim seconds deleted (<= 0 off)
