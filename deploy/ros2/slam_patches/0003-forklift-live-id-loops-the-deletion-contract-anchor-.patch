+TEST(forklift_delete, the_dataset_remover_has_one_owner)
+{
+  int a = 0, b = 0, calls = 0;
+  karto::forklift::set_dataset_remover(&a, [&](karto::LocalizedRangeScan *) {calls++;});
+  karto::forklift::clear_dataset_remover(&b);           // not the owner: no effect
+  karto::forklift::remove_from_dataset(nullptr);
+  EXPECT_EQ(calls, 1);
+  EXPECT_EXIT(karto::forklift::set_dataset_remover(&b, [](karto::LocalizedRangeScan *) {}),
+    ::testing::ExitedWithCode(3), "second slam_toolbox node");
+  karto::forklift::clear_dataset_remover(&a);
+  EXPECT_DEATH(karto::forklift::remove_from_dataset(nullptr), "no dataset owner");
+}
