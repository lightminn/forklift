+// Deletes one scan's node in the lifelong order (design v3 3.3): graph edges, constraints and solver node, the
+// sensor manager's maps, the dataset (which frees the scan), then the vertex. The caller holds smapper_mutex_.
+bool forklift_delete_node(Mapper * pMapper, LocalizedRangeScan * pVictim)
+{
+  MapperGraph * pGraph = pMapper->GetGraph();
+  const auto & vertexMap = pGraph->GetVertices();
+  auto byName = vertexMap.find(pVictim->GetSensorName());
+  if (byName == vertexMap.end()) {
+    return false;
+  }
+  auto found = byName->second.find(pVictim->GetStateId());
+  if (found == byName->second.end() || found->second == NULL) {
+    return false;
+  }
+  Vertex<LocalizedRangeScan> * pVertex = found->second;
+  if (!pMapper->RemoveNodeFromGraph(pVertex)) {
+    return false;
+  }
+  pMapper->GetMapperSensorManager()->RemoveScan(pVictim);
+  forklift::remove_from_dataset(pVictim);  // frees the scan
+  pVertex->RemoveObject();
+  delete pVertex;
+  return true;
+}
+
+// C (design v3 3.3): after a processed keyframe, the nodes older than T sim seconds, in state id order, except the
+// running scans, the last scan and the scan just added.
+void forklift_delete_older(Mapper * pMapper, LocalizedRangeScan * pScan)
+{
+  const double delete_s = forklift::config().delete_s;
+  if (delete_s <= 0.0) {
+    return;
+  }
+  forklift::ScopedTimer timer("delete_older");
+  MapperSensorManager * pManager = pMapper->GetMapperSensorManager();
+  const Name & name = pScan->GetSensorName();
+  LocalizedRangeScanVector & running = pManager->GetRunningScans(name);
+  LocalizedRangeScan * pLast = pManager->GetLastScan(name);
+  std::vector<forklift::Candidate> byId;
+  for (const auto & kv : pManager->GetScans(name)) {
+    LocalizedRangeScan * s = kv.second;
+    if (s == NULL) {
+      continue;
+    }
+    if (s->GetTime() >= pScan->GetTime() - delete_s) {
+      break;  // ids are in time order: the rest are newer
+    }
+    const bool kept = s == pScan || s == pLast ||
+      std::find(running.begin(), running.end(), s) != running.end();
+    byId.push_back({kv.first, s->GetTime(), kept});
+  }
+  for (int id : forklift::older_than(byId, pScan->GetTime() - delete_s)) {
+    LocalizedRangeScan * pVictim = pManager->GetScan(name, id);
+    if (pVictim != NULL && forklift_delete_node(pMapper, pVictim)) {
+      forklift::add_count("deleted_nodes", 1);
+    } else {
+      forklift::add_count("delete_failed", 1);
+    }
+  }
+}
