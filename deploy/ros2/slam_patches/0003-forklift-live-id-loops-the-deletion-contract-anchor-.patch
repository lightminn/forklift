+TEST(forklift_delete, live_id_steps_skip_the_holes_with_one_lookup_each)
+{
+  std::map<int, int *> scans;
+  EXPECT_EQ(karto::forklift::live_id_at_or_after(scans, 0, 5), 5);
+  EXPECT_EQ(karto::forklift::live_id_prev(scans, 3), -1);
+  for (int id : {4, 5, 9, 12}) {scans[id] = nullptr;}   // 0..3, 6..8, 10, 11 deleted
+  const long end = karto::forklift::live_id_end(scans);
+  EXPECT_EQ(end, 13);
+  EXPECT_EQ(karto::forklift::live_id_at_or_after(scans, 0, end), 4);
+  EXPECT_EQ(karto::forklift::live_id_at_or_after(scans, 5, end), 5);
+  EXPECT_EQ(karto::forklift::live_id_next(scans, 5, end), 9);
+  EXPECT_EQ(karto::forklift::live_id_next(scans, 12, end), 13);
+  EXPECT_EQ(karto::forklift::live_id_prev(scans, 9), 5);
+  EXPECT_EQ(karto::forklift::live_id_prev(scans, 4), -1);
+  // a forward walk visits the live ids and nothing else
+  std::vector<long> seen;
+  for (long id = karto::forklift::live_id_at_or_after(scans, 0, end); id < end;
+    id = karto::forklift::live_id_next(scans, id, end)) {seen.push_back(id);}
+  EXPECT_EQ(seen, (std::vector<long>{4, 5, 9, 12}));
+  seen.clear();
+  for (long id = karto::forklift::live_id_prev(scans, 12); id >= 0; id = karto::forklift::live_id_prev(scans, id)) {
+    seen.push_back(id);
+  }
+  EXPECT_EQ(seen, (std::vector<long>{9, 5, 4}));
+}
