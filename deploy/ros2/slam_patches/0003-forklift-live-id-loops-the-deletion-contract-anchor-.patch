+namespace
+{
+std::mutex & remover_mutex()
+{
+  static std::mutex m;
+  return m;
+}
+std::function<void(LocalizedRangeScan *)> & remover_slot()
+{
+  static std::function<void(LocalizedRangeScan *)> f;
+  return f;
+}
+const void * & remover_owner()
+{
+  static const void * owner = nullptr;
+  return owner;
+}
+}  // namespace
+
+void set_dataset_remover(const void * owner, std::function<void(LocalizedRangeScan *)> remover)
+{
+  std::lock_guard<std::mutex> lock(remover_mutex());
+  if (remover_owner() != nullptr && remover_owner() != owner) {
+    std::fprintf(stderr, "forklift_slam_patch refused: a second slam_toolbox node in one process with a deleting "
+      "feature on\n");
+    std::fflush(stderr);
+    std::exit(3);
+  }
+  remover_owner() = owner;
+  remover_slot() = std::move(remover);
+}
+
+void clear_dataset_remover(const void * owner)
+{
+  std::lock_guard<std::mutex> lock(remover_mutex());
+  if (remover_owner() == owner) {
+    remover_owner() = nullptr;
+    remover_slot() = nullptr;
+  }
+}
+
+void remove_from_dataset(LocalizedRangeScan * scan)
+{
+  std::function<void(LocalizedRangeScan *)> f;
+  {
+    std::lock_guard<std::mutex> lock(remover_mutex());
+    f = remover_slot();
+  }
+  if (!f) {
+    std::fprintf(stderr, "forklift_slam_patch abort: a node was deleted with no dataset owner registered\n");
+    std::fflush(stderr);
+    std::abort();
+  }
+  f(scan);
+}
