+// The scan store's owner (SlamToolbox's dataset_) frees a deleted scan: it registers here, the deletion calls it
+// (design v3 3.3, the lifelong order). Deleting with no owner registered ends the node. The slot has one owner at a
+// time: a second owner registering ends the node, and clearing takes effect only for the owner that registered.
+void set_dataset_remover(const void * owner, std::function<void(LocalizedRangeScan *)> remover);
+void clear_dataset_remover(const void * owner);
+void remove_from_dataset(LocalizedRangeScan * scan);
+
+// The id bound for a loop over state ids once ids can have holes: one past the largest live id (size() would leave
+// the newest ids out). With nothing deleted the two are the same.
+template<class ScanMap>
+long live_id_end(const ScanMap & scans)
+{
+  return scans.empty() ? 0 : static_cast<long>(scans.rbegin()->first) + 1;
+}
+
+// Stepping a state id loop over the live ids only once ids can have holes (Codex code review 2 P2-1): a numeric step
+// would walk every deleted id since 0, so a loop's cost would grow with the ids ever made rather than the live ones.
+// at_or_after: the first live id >= id, else end. next: the first live id > id, else end. prev: the last live id < id,
+// else -1. Each is one map lookup.
+template<class ScanMap>
+long live_id_at_or_after(const ScanMap & scans, long id, long end)
+{
+  if (id > std::numeric_limits<int>::max()) {  // past every int id (no narrowing back to a small id)
+    return end;
+  }
+  auto it = scans.lower_bound(static_cast<int>(id));
+  return it == scans.end() ? end : static_cast<long>(it->first);
+}
+template<class ScanMap>
+long live_id_next(const ScanMap & scans, long id, long end)
+{
+  if (id >= std::numeric_limits<int>::max()) {
+    return end;
+  }
+  auto it = scans.upper_bound(static_cast<int>(id));
+  return it == scans.end() ? end : static_cast<long>(it->first);
+}
+template<class ScanMap>
+long live_id_prev(const ScanMap & scans, long id)
+{
+  auto it = id > std::numeric_limits<int>::max() ? scans.end() : scans.lower_bound(static_cast<int>(id));
+  if (it == scans.begin()) {
+    return -1;
+  }
+  --it;
+  return static_cast<long>(it->first);
+}
+
+// C's victims: in state id order (time nondecreasing), the ids older than the threshold, stopping at the first that
+// is not; a protected id (running scans, the last scan, the scan being added) is kept and does not stop the walk.
+struct Candidate
+{
+  int id;
+  double time;
+  bool kept;
+};
+inline std::vector<int> older_than(const std::vector<Candidate> & by_id, double threshold)
+{
+  std::vector<int> out;
+  for (const Candidate & c : by_id) {
+    if (c.time >= threshold) {
+      break;
+    }
+    if (!c.kept) {
+      out.push_back(c.id);
+    }
+  }
+  return out;
+}
+
+// The new anchor once the fixed node is deleted: the oldest live node, i.e. the smallest id (-1 when none).
+template<class NodeMap>
+int oldest_id(const NodeMap & nodes)
+{
+  int best = -1;
+  for (const auto & kv : nodes) {
+    if (best < 0 || kv.first < best) {
+      best = kv.first;
+    }
+  }
+  return best;
+}
