+TEST(forklift_trace, a_trace_ends_with_its_end_record_at_exit)
+{
+  // a fresh process (threadsafe death tests re-run the binary), so the configuration reads this trace path
+  ::testing::FLAGS_gtest_death_test_style = "threadsafe";
+  const std::string path = ::testing::TempDir() + "forklift_trace_end.jsonl";
+  std::remove(path.c_str());
+  EXPECT_EXIT(
+  {
+    setenv("FORKLIFT_SLAM_TRACE", path.c_str(), 1);
+    karto::forklift::begin_scan();
+    karto::forklift::add_time("scan_match", 0.5);
+    karto::forklift::end_scan(true, 7, 1.25, 0.0);
+    std::exit(0);
+  }, ::testing::ExitedWithCode(0), "");
+  std::ifstream in(path);
+  std::string line, last, first;
+  while (std::getline(in, line)) {
+    if (first.empty()) {first = line;}
+    last = line;
+  }
+  EXPECT_NE(first.find("\"state_id\":7"), std::string::npos);
+  EXPECT_EQ(last, "{\"kind\":\"end\",\"flushes\":1}");
+}
