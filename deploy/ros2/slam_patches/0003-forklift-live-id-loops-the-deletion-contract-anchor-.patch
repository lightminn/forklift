+TEST(forklift_anchor, the_new_anchor_is_the_oldest_live_node_even_after_a_rehash)
+{
+  std::unordered_map<int, double> nodes;
+  EXPECT_EQ(karto::forklift::oldest_id(nodes), -1);
+  for (int id = 10; id < 200; ++id) {nodes[id] = id;}   // grows through several rehashes
+  nodes.erase(10);
+  EXPECT_EQ(karto::forklift::oldest_id(nodes), 11);
+  nodes.erase(11); nodes.erase(12);
+  EXPECT_EQ(karto::forklift::oldest_id(nodes), 13);
+}
