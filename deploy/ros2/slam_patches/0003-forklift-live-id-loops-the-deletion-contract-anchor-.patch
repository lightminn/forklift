+TEST(forklift_delete, older_than_stops_at_the_first_newer_scan_and_skips_kept_ones)
+{
+  using karto::forklift::Candidate;
+  const std::vector<Candidate> by_id{{0, 0.0, false}, {1, 1.0, true}, {2, 2.0, false}, {5, 3.0, false},
+    {6, 9.0, false}};
+  EXPECT_EQ(karto::forklift::older_than(by_id, 3.0), (std::vector<int>{0, 2}));   // 1 kept (running/last)
+  EXPECT_EQ(karto::forklift::older_than(by_id, 0.0), (std::vector<int>{}));       // nothing older
+  EXPECT_EQ(karto::forklift::older_than(by_id, 100.0), (std::vector<int>{0, 2, 5, 6}));
+}
+
+TEST(forklift_delete, the_id_bound_is_one_past_the_largest_live_id)
+{
+  std::map<int, int *> scans;
+  EXPECT_EQ(karto::forklift::live_id_end(scans), 0);
+  scans[0] = nullptr; scans[1] = nullptr; scans[2] = nullptr;
+  EXPECT_EQ(karto::forklift::live_id_end(scans), 3);   // no holes: the same as size()
+  scans.erase(0); scans.erase(1); scans[7] = nullptr;  // holes: size() would be 2
+  EXPECT_EQ(karto::forklift::live_id_end(scans), 8);
+}
