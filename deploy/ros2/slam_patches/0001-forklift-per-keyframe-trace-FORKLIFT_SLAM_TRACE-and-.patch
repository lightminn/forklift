diff --git a/lib/karto_sdk/include/karto_sdk/ForkliftPatch.h b/lib/karto_sdk/include/karto_sdk/ForkliftPatch.h
new file mode 100644
index 0000000..dfc841b
--- /dev/null
+++ b/lib/karto_sdk/include/karto_sdk/ForkliftPatch.h
@@ -0,0 +1,78 @@
+/*
+ * Forklift online-SLAM comparison patches (forklift repository docs/design/2026-11-13-slam-patch-build.md).
+ *
+ * Everything here is switched by environment variables read once; with none set the mapper runs its upstream code
+ * paths (P0). This file holds what every patch shares: the configuration, the start identification line and the
+ * per-keyframe trace (FORKLIFT_SLAM_TRACE). The trace lives in a process-wide object so that no karto class changes
+ * its layout for it.
+ */
+#ifndef KARTO_SDK__FORKLIFTPATCH_H_
+#define KARTO_SDK__FORKLIFTPATCH_H_
+
+#include <chrono>
+#include <cstdint>
+#include <map>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace karto
+{
+namespace forklift
+{
+
+struct Config
+{
+  std::string trace;  // FORKLIFT_SLAM_TRACE: the trace file ('' = off)
+};
+
+// The configuration, read from the environment on first use (thread-safe).
+const Config & config();
+
+// Prints the identification line once to stderr: "forklift_slam_patch series=<id> trace=<0|1>".
+void announce();
+
+// True when the trace is on; a timer or a counter does nothing (not even read a clock) when it is off.
+bool tracing();
+
+// The keyframe record being filled: Process opens it, the node closes it once the scan's lock is released.
+void begin_scan();
+void add_time(const char * name, double seconds);
+void add_count(const char * name, std::int64_t n);
+// Ends the record: processed or not, the state id, the scan stamp (s) and the lock wait measured by the caller.
+void end_scan(bool processed, int state_id, double stamp_s, double lock_wait_s);
+// A separate record for a map regeneration (updateMap): its lock wait and its time.
+void map_update(double lock_wait_s, double seconds);
+// Writes what is buffered (also every 1000 records and at exit). A write that fails ends the node.
+void flush();
+
+// Adds its lifetime to the current record under `name` when the trace is on.
+class ScopedTimer
+{
+public:
+  explicit ScopedTimer(const char * name)
+  : name_(name), on_(tracing())
+  {
+    if (on_) {
+      start_ = std::chrono::steady_clock::now();
+    }
+  }
+  ~ScopedTimer()
+  {
+    if (on_) {
+      add_time(name_, std::chrono::duration<double>(std::chrono::steady_clock::now() - start_).count());
+    }
+  }
+  ScopedTimer(const ScopedTimer &) = delete;
+  ScopedTimer & operator=(const ScopedTimer &) = delete;
+
+private:
+  const char * name_;
+  bool on_;
+  std::chrono::steady_clock::time_point start_;
+};
+
+}  // namespace forklift
+}  // namespace karto
+
+#endif  // KARTO_SDK__FORKLIFTPATCH_H_
diff --git a/lib/karto_sdk/src/ForkliftPatch.cpp b/lib/karto_sdk/src/ForkliftPatch.cpp
new file mode 100644
index 0000000..5bb1809
--- /dev/null
+++ b/lib/karto_sdk/src/ForkliftPatch.cpp
@@ -0,0 +1,223 @@
+/*
+ * Forklift online-SLAM comparison patches: configuration, identification and the per-keyframe trace
+ * (see karto_sdk/ForkliftPatch.h).
+ */
+#include "karto_sdk/ForkliftPatch.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <sstream>
+
+#ifndef FORKLIFT_SLAM_PATCH_SERIES
+#define FORKLIFT_SLAM_PATCH_SERIES "unknown"
+#endif
+
+namespace karto
+{
+namespace forklift
+{
+
+namespace
+{
+
+struct Record
+{
+  std::map<std::string, double> times;
+  std::map<std::string, std::int64_t> counts;
+  std::chrono::steady_clock::time_point started;
+  bool open = false;
+};
+
+struct TraceState
+{
+  std::mutex mutex;
+  Record current;
+  std::vector<std::string> lines;
+  std::int64_t flushes = 0;
+  ~TraceState();
+};
+
+const std::size_t FLUSH_EVERY = 1000;
+
+TraceState & state()
+{
+  static TraceState s;
+  return s;
+}
+
+std::string json_escape(const std::string & text)
+{
+  std::string out;
+  for (char c : text) {
+    if (c == '"' || c == '\\') {
+      out.push_back('\\');
+    }
+    out.push_back(c);
+  }
+  return out;
+}
+
+// Writes the buffered lines; the caller holds the state mutex.
+void write_locked(TraceState & s)
+{
+  const Config & cfg = config();
+  if (cfg.trace.empty() || s.lines.empty()) {
+    return;
+  }
+  auto start = std::chrono::steady_clock::now();
+  std::FILE * f = std::fopen(cfg.trace.c_str(), "a");
+  bool ok = f != nullptr;
+  if (ok) {
+    for (const std::string & line : s.lines) {
+      ok = ok && std::fputs(line.c_str(), f) >= 0 && std::fputc('\n', f) != EOF;
+    }
+    double took = std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count();
+    ok = ok && std::fprintf(f, "{\"kind\":\"flush\",\"lines\":%zu,\"write_s\":%.9f}\n", s.lines.size(), took) > 0;
+    ok = (std::fclose(f) == 0) && ok;
+  }
+  if (!ok) {
+    // a trace that cannot be written ends the run rather than lose its records quietly
+    std::fprintf(stderr, "forklift_slam_patch abort: cannot write the trace %s\n", cfg.trace.c_str());
+    std::fflush(stderr);
+    std::abort();
+  }
+  s.lines.clear();
+  s.flushes++;
+}
+
+TraceState::~TraceState()
+{
+  std::lock_guard<std::mutex> lock(mutex);
+  write_locked(*this);
+}
+
+}  // namespace
+
+const Config & config()
+{
+  static const Config cfg = [] {
+      Config c;
+      const char * trace = std::getenv("FORKLIFT_SLAM_TRACE");
+      if (trace != nullptr) {
+        c.trace = trace;
+      }
+      // at exit the buffered lines are written by TraceState's destructor alone: TraceState is created after this
+      // configuration, so it is destroyed before it
+      return c;
+    }();
+  return cfg;
+}
+
+void announce()
+{
+  static std::once_flag once;
+  std::call_once(once, [] {
+      const Config & c = config();
+      std::fprintf(stderr, "forklift_slam_patch series=%s trace=%d\n", FORKLIFT_SLAM_PATCH_SERIES,
+      c.trace.empty() ? 0 : 1);
+      std::fflush(stderr);
+    });
+}
+
+bool tracing()
+{
+  return !config().trace.empty();
+}
+
+void begin_scan()
+{
+  if (!tracing()) {
+    return;
+  }
+  TraceState & s = state();
+  std::lock_guard<std::mutex> lock(s.mutex);
+  s.current = Record();
+  s.current.open = true;
+  s.current.started = std::chrono::steady_clock::now();
+}
+
+void add_time(const char * name, double seconds)
+{
+  if (!tracing()) {
+    return;
+  }
+  TraceState & s = state();
+  std::lock_guard<std::mutex> lock(s.mutex);
+  if (s.current.open) {
+    s.current.times[name] += seconds;
+  }
+}
+
+void add_count(const char * name, std::int64_t n)
+{
+  if (!tracing()) {
+    return;
+  }
+  TraceState & s = state();
+  std::lock_guard<std::mutex> lock(s.mutex);
+  if (s.current.open) {
+    s.current.counts[name] += n;
+  }
+}
+
+void end_scan(bool processed, int state_id, double stamp_s, double lock_wait_s)
+{
+  if (!tracing()) {
+    return;
+  }
+  TraceState & s = state();
+  std::lock_guard<std::mutex> lock(s.mutex);
+  if (!s.current.open) {
+    return;
+  }
+  std::ostringstream line;
+  line.precision(9);
+  line << std::fixed << "{\"kind\":\"scan\",\"processed\":" << (processed ? "true" : "false")
+       << ",\"state_id\":" << state_id << ",\"stamp_s\":" << stamp_s << ",\"lock_wait_s\":" << lock_wait_s
+       << ",\"since_begin_s\":"
+       << std::chrono::duration<double>(std::chrono::steady_clock::now() - s.current.started).count();
+  for (const auto & kv : s.current.times) {
+    line << ",\"" << json_escape(kv.first) << "_s\":" << kv.second;
+  }
+  for (const auto & kv : s.current.counts) {
+    line << ",\"" << json_escape(kv.first) << "\":" << kv.second;
+  }
+  line << "}";
+  s.current.open = false;
+  // only the processed keyframes are kept (a skipped scan never reaches the graph)
+  if (processed) {
+    s.lines.push_back(line.str());
+    if (s.lines.size() >= FLUSH_EVERY) {
+      write_locked(s);
+    }
+  }
+}
+
+void map_update(double lock_wait_s, double seconds)
+{
+  if (!tracing()) {
+    return;
+  }
+  TraceState & s = state();
+  std::lock_guard<std::mutex> lock(s.mutex);
+  std::ostringstream line;
+  line.precision(9);
+  line << std::fixed << "{\"kind\":\"map\",\"lock_wait_s\":" << lock_wait_s << ",\"update_s\":" << seconds << "}";
+  s.lines.push_back(line.str());
+  if (s.lines.size() >= FLUSH_EVERY) {
+    write_locked(s);
+  }
+}
+
+void flush()
+{
+  if (!tracing()) {
+    return;
+  }
+  TraceState & s = state();
+  std::lock_guard<std::mutex> lock(s.mutex);
+  write_locked(s);
+}
+
+}  // namespace forklift
+}  // namespace karto
