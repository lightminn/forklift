+// S1's chain for a near permanent node outside the running scans: the node and its live neighbours by id, backward
+// then forward, while within link_scan_maximum_distance of the new scan (as FindNearChains measures); never the new
+// scan.
+LocalizedRangeScanVector chain_around(Mapper * pMapper, LocalizedRangeScan * pScan, int nearId)
+{
+  const LocalizedRangeScanMap & scans = pMapper->GetMapperSensorManager()->GetScans(pScan->GetSensorName());
+  const bool barycenter = pMapper->getParamUseScanBarycenter();
+  const Pose2 pose = pScan->GetReferencePose(barycenter);
+  const double limit = math::Square(pMapper->getParamLinkScanMaximumDistance()) + KT_TOLERANCE;
+  auto near = [&](LocalizedRangeScan * s) {
+      return pose.GetPosition().SquaredDistance(s->GetReferencePose(barycenter).GetPosition()) < limit;
+    };
+  std::list<LocalizedRangeScan *> chain;
+  auto at = scans.find(nearId);
+  if (at == scans.end() || at->second == NULL) {
+    return LocalizedRangeScanVector();
+  }
+  chain.push_back(at->second);
+  for (auto it = std::make_reverse_iterator(at); it != scans.rend(); ++it) {
+    if (it->second == NULL || it->second == pScan) {
+      continue;
+    }
+    if (!near(it->second)) {
+      break;
+    }
+    chain.push_front(it->second);
+  }
+  for (auto it = std::next(at); it != scans.end(); ++it) {
+    if (it->second == NULL || it->second == pScan) {
+      break;  // the new scan is the newest id: the forward walk ends there
+    }
+    if (!near(it->second)) {
+      break;
+    }
+    chain.push_back(it->second);
+  }
+  return LocalizedRangeScanVector(chain.begin(), chain.end());
+}
+
+// S1's judgement (design v3 3 item 4) of the new scan, linked and at its final pose: the nearest live permanent node
+// within 0.3 m and 0.35 rad of its corrected pose. It must already be among the scans linked near the new one
+// (nearLinked(): FindNearLinkedScans within loop_search_maximum_distance, the set loop closing leaves out) -- a node
+// reached only across an unclosed loop stays a loop candidate, and the new scan stays permanent so that the loop is
+// closed by the loop checks and the optimizer (Codex code review 5 P2-1). If the new scan then matches that node's
+// chain with at least link_match_minimum_response_fine (one sequential match without the odometry penalty, as
+// LinkNearChains), it is temporary (with that match's pose and covariance to link it to the node by), otherwise
+// permanent.
+template<class NearLinked>
+Judgement judge(Mapper * pMapper, LocalizedRangeScan * pScan, NearLinked nearLinked)
+{
+  Judgement out;
+  forklift::ScopedTimer timer("s1_judge");
+  forklift::S1State & st = forklift::s1_owned_by(pMapper);
+  st.keyframes++;
+  MapperSensorManager * pManager = pMapper->GetMapperSensorManager();
+  const Name & name = pScan->GetSensorName();
+  const Pose2 me = pScan->GetCorrectedPose();
+  std::vector<forklift::NearCandidate> candidates;
+  for (const auto & kv : pManager->GetScans(name)) {
+    LocalizedRangeScan * s = kv.second;
+    if (s == NULL || s == pScan) {
+      continue;
+    }
+    const Pose2 other = s->GetCorrectedPose();
+    const double dist = std::hypot(other.GetX() - me.GetX(), other.GetY() - me.GetY());
+    if (dist > 0.3) {
+      continue;
+    }
+    candidates.push_back({kv.first, dist, math::NormalizeAngle(other.GetHeading() - me.GetHeading()),
+        st.temporary.count(kv.first) == 0});
+  }
+  int nearId = forklift::nearest_valid_permanent(candidates, 0.3, 0.35);
+  if (nearId >= 0) {
+    const LocalizedRangeScanVector linked = nearLinked();
+    if (std::find(linked.begin(), linked.end(), pManager->GetScan(name, nearId)) == linked.end()) {
+      forklift::add_count("s1_near_not_linked", 1);
+      forklift::set_value("s1_unlinked_near_id", nearId);
+      nearId = -1;
+    }
+  }
+  if (nearId >= 0) {
+    LocalizedRangeScan * pNear = pManager->GetScan(name, nearId);
+    double response = -1.0;
+    {
+      forklift::ScopedTimer match_timer("s1_match");
+      forklift::add_count("s1_matches", 1);
+      const LocalizedRangeScanVector chain = chain_around(pMapper, pScan, nearId);
+      forklift::add_count("s1_chain_scans", static_cast<std::int64_t>(chain.size()));
+      if (!chain.empty()) {
+        response = pMapper->GetSequentialScanMatcher()->MatchScan(pScan, chain, out.mean, out.covariance, false);
+      }
+    }
+    out.temporary = response > pMapper->getParamLinkMatchMinimumResponseFine() - KT_TOLERANCE;
+    out.pNear = pNear;
+    for (const forklift::NearCandidate & c : candidates) {
+      if (c.id == nearId) {
+        forklift::set_value("s1_near_dist_m", c.dist);
+        forklift::set_value("s1_near_dyaw_rad", c.dyaw);
+      }
+    }
+    forklift::set_value("s1_near_id", nearId);
+    forklift::set_value("s1_response", response);
+  }
+  if (out.temporary) {
+    st.temporary[pScan->GetStateId()] = forklift::S1Mark{st.keyframes};
+  }
+  forklift::add_count("s1_temporary", out.temporary ? 1 : 0);
+  return out;
+}
+}  // namespace forklift_s1
