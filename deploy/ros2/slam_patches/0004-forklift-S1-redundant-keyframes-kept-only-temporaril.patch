+TEST(forklift_s1, the_nearest_valid_permanent_node_is_not_hidden_by_a_nearer_invalid_one)
+{
+  using karto::forklift::NearCandidate;
+  using karto::forklift::nearest_valid_permanent;
+  EXPECT_EQ(nearest_valid_permanent({}, 0.3, 0.35), -1);
+  // nearest is temporary, next is misaligned, then a valid one
+  const std::vector<NearCandidate> c{{1, 0.05, 0.0, false}, {2, 0.10, 0.5, true}, {3, 0.20, -0.30, true},
+    {4, 0.25, 0.0, true}};
+  EXPECT_EQ(nearest_valid_permanent(c, 0.3, 0.35), 3);
+  // out of range in distance or heading
+  EXPECT_EQ(nearest_valid_permanent({{5, 0.31, 0.0, true}, {6, 0.1, -0.36, true}}, 0.3, 0.35), -1);
+  // a tie goes to the older id
+  EXPECT_EQ(nearest_valid_permanent({{9, 0.1, 0.0, true}, {7, 0.1, 0.0, true}}, 0.3, 0.35), 7);
+}
+
+TEST(forklift_s1, due_temporaries_are_those_born_at_least_b_keyframes_ago_in_id_order)
+{
+  std::map<int, karto::forklift::S1Mark> t{{12, {5}}, {3, {1}}, {20, {14}}};
+  EXPECT_EQ(karto::forklift::s1_due(t, 10, 10), (std::vector<int>{}));
+  EXPECT_EQ(karto::forklift::s1_due(t, 11, 10), (std::vector<int>{3}));
+  EXPECT_EQ(karto::forklift::s1_due(t, 15, 10), (std::vector<int>{3, 12}));
+  EXPECT_EQ(karto::forklift::s1_due(t, 24, 10), (std::vector<int>{3, 12, 20}));
+}
+
+TEST(forklift_s1, the_disconnect_check_on_a_chain_a_ring_and_a_leaf)
+{
+  std::map<int, std::vector<int>> g;
+  auto adj = [&](int id) {return g[id];};
+  auto link = [&](int a, int b) {g[a].push_back(b); g[b].push_back(a);};
+  // chain 1-2-3: removing 2 splits 1 from 3
+  link(1, 2); link(2, 3);
+  EXPECT_FALSE(karto::forklift::still_connected(2, g[2], adj));
+  // a ring 1-2-3-4-1: removing 2 keeps 1 and 3 connected through 4
+  link(3, 4); link(4, 1);
+  EXPECT_TRUE(karto::forklift::still_connected(2, g[2], adj));
+  // a leaf 5 on 4: removing it never disconnects
+  link(4, 5);
+  EXPECT_TRUE(karto::forklift::still_connected(5, g[5], adj));
+  // a node with three neighbours, two of them reachable only through it
+  link(6, 7); link(6, 8); link(6, 1);
+  EXPECT_FALSE(karto::forklift::still_connected(6, g[6], adj));
+  link(7, 8); link(8, 3);
+  EXPECT_TRUE(karto::forklift::still_connected(6, g[6], adj));
+}
