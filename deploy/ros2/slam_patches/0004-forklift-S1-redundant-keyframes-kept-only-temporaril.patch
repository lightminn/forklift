+// S1 (design v3 3 item 4, plan 3.4): redundant keyframes kept only temporarily.
+// A node is permanent unless marked temporary; the marks and each temporary node's birth keyframe live here, outside
+// the Mapper, for the one mapping node of the process (the same scope as the dataset owner). They name state ids of one
+// sensor manager generation, so Mapper::Initialize (a new one) and Mapper::Reset clear them.
+struct S1Mark
+{
+  std::int64_t born;  // the S1 keyframe count when it was judged temporary
+};
+struct S1State
+{
+  std::map<int, S1Mark> temporary;  // live temporary ids
+  std::int64_t keyframes = 0;       // keyframes judged so far
+  std::int64_t deleted = 0;         // temporary nodes deleted so far
+  std::int64_t promoted = 0;        // temporary nodes made permanent so far (deleting them would disconnect the graph)
+  const void * owner = nullptr;     // the mapper whose sensor manager the ids belong to
+};
+// The state; the caller holds the mapper's lock (smapper_mutex_).
+S1State & s1_state();
+// The state, for its owner mapper only: another mapper using S1 ends the node (one mapping node per process).
+S1State & s1_owned_by(const void * mapper);
+// True for a live temporary node (never when S1 is off).
+bool s1_temporary(int id);
+
+// S1's near permanent node: of the candidates (offsets from the new scan, heading difference wrapped), the nearest in
+// XY that is permanent and within max_dist and max_yaw; -1 when none. A nearer temporary or misaligned node does not
+// hide a valid one behind it.
+struct NearCandidate
+{
+  int id;
+  double dist;
+  double dyaw;
+  bool permanent;
+};
+inline int nearest_valid_permanent(const std::vector<NearCandidate> & candidates, double max_dist, double max_yaw)
+{
+  int best = -1;
+  double best_dist = 0.0;
+  for (const NearCandidate & c : candidates) {
+    if (!c.permanent || c.dist > max_dist || c.dyaw > max_yaw || c.dyaw < -max_yaw) {
+      continue;
+    }
+    if (best < 0 || c.dist < best_dist || (c.dist == best_dist && c.id < best)) {
+      best = c.id;
+      best_dist = c.dist;
+    }
+  }
+  return best;
+}
+
+// The temporary nodes due for deletion: born at least `buffer` keyframes before `keyframes`, in id order.
+inline std::vector<int> s1_due(const std::map<int, S1Mark> & temporary, std::int64_t keyframes, int buffer)
+{
+  std::vector<int> out;
+  for (const auto & kv : temporary) {
+    if (keyframes - kv.second.born >= buffer) {
+      out.push_back(kv.first);
+    }
+  }
+  return out;
+}
+
+// Would deleting `victim` disconnect the graph? Its neighbours must stay connected to each other without it: a
+// breadth-first search (first in, first out) from the first neighbour, never through the victim, stopping once every
+// neighbour is reached. Its worst case, a deletion that does disconnect, visits the victim's whole component.
+// adjacent(id) gives the ids next to id. Zero or one neighbour never disconnects.
+template<class Adjacent>
+bool still_connected(int victim, const std::vector<int> & neighbours, Adjacent adjacent)
+{
+  std::vector<int> wanted;
+  for (int n : neighbours) {
+    if (n != victim && std::find(wanted.begin(), wanted.end(), n) == wanted.end()) {
+      wanted.push_back(n);
+    }
+  }
+  if (wanted.size() < 2) {
+    return true;
+  }
+  std::map<int, bool> seen{{victim, true}, {wanted[0], true}};
+  std::deque<int> frontier{wanted[0]};
+  std::size_t found = 1;
+  while (!frontier.empty() && found < wanted.size()) {
+    const int at = frontier.front();
+    frontier.pop_front();
+    for (int next : adjacent(at)) {
+      if (seen.count(next)) {
+        continue;
+      }
+      seen[next] = true;
+      if (std::find(wanted.begin(), wanted.end(), next) != wanted.end()) {
+        found++;
+      }
+      frontier.push_back(next);
+    }
+  }
+  return found == wanted.size();
+}
