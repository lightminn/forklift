+TEST(forklift_s1, the_disconnect_check_on_a_chain_a_ring_and_a_leaf)
+{
+  std::map<int, std::vector<int>> g;
+  auto adj = [&](int id) {return g[id];};
+  auto link = [&](int a, int b) {g[a].push_back(b); g[b].push_back(a);};
+  // chain 1-2-3: removing 2 splits 1 from 3
+  link(1, 2); link(2, 3);
+  EXPECT_FALSE(karto::forklift::still_connected(2, g[2], adj));
+  // a ring 1-2-3-4-1: removing 2 keeps 1 and 3 connected through 4
+  link(3, 4); link(4, 1);
+  EXPECT_TRUE(karto::forklift::still_connected(2, g[2], adj));
+  // a leaf 5 on 4: removing it never disconnects
+  link(4, 5);
+  EXPECT_TRUE(karto::forklift::still_connected(5, g[5], adj));
+  // a node with three neighbours, two of them reachable only through it
+  link(6, 7); link(6, 8); link(6, 1);
+  EXPECT_FALSE(karto::forklift::still_connected(6, g[6], adj));
+  link(7, 8); link(8, 3);
+  EXPECT_TRUE(karto::forklift::still_connected(6, g[6], adj));
+}
+
+TEST(forklift_s1, the_disconnect_check_searches_breadth_first)
+{
+  // victim 0 between 1 and 2; 1 reaches 2 in two hops through 3, and also leads into a 1000-node branch listed last
+  // (a stack would take the branch first and walk all of it; Codex code review 5 P3)
+  std::map<int, std::vector<int>> g;
+  for (int i = 100; i < 1100; ++i) {g[i] = {i + 1};}
+  g[1] = {0, 3, 100};
+  g[3] = {1, 2};
+  g[2] = {3, 0};
+  g[0] = {1, 2};
+  int visited = 0;
+  auto adj = [&](int id) {visited++; return g[id];};
+  EXPECT_TRUE(karto::forklift::still_connected(0, g[0], adj));
+  EXPECT_LE(visited, 3);
+}
