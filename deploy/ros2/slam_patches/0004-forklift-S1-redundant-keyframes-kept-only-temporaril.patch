+// S1's chain for a near permanent node outside the running scans: the node and its live neighbours by id, backward
+// then forward, while within link_scan_maximum_distance of the new scan (as FindNearChains measures); never the new
+// scan.
+LocalizedRangeScanVector forklift_s1_chain(Mapper * pMapper, LocalizedRangeScan * pScan, int nearId)
+{
+  const LocalizedRangeScanMap & scans = pMapper->GetMapperSensorManager()->GetScans(pScan->GetSensorName());
+  const bool barycenter = pMapper->getParamUseScanBarycenter();
+  const Pose2 pose = pScan->GetReferencePose(barycenter);
+  const double limit = math::Square(pMapper->getParamLinkScanMaximumDistance()) + KT_TOLERANCE;
+  auto near = [&](LocalizedRangeScan * s) {
+      return pose.GetPosition().SquaredDistance(s->GetReferencePose(barycenter).GetPosition()) < limit;
+    };
+  std::list<LocalizedRangeScan *> chain;
+  auto at = scans.find(nearId);
+  if (at == scans.end() || at->second == NULL) {
+    return LocalizedRangeScanVector();
+  }
+  chain.push_back(at->second);
+  for (auto it = std::make_reverse_iterator(at); it != scans.rend(); ++it) {
+    if (it->second == NULL || it->second == pScan) {
+      continue;
+    }
+    if (!near(it->second)) {
+      break;
+    }
+    chain.push_front(it->second);
+  }
+  for (auto it = std::next(at); it != scans.end(); ++it) {
+    if (it->second == NULL || it->second == pScan) {
+      break;  // the new scan is the newest id: the forward walk ends there
+    }
+    if (!near(it->second)) {
+      break;
+    }
+    chain.push_back(it->second);
+  }
+  return LocalizedRangeScanVector(chain.begin(), chain.end());
+}
+
+// S1 (design v3 3 item 4): after the new scan is in the graph and linked, before loop closing. The nearest live
+// permanent node within 0.3 m and 0.35 rad of its corrected pose; if the new scan matches that node's chain with at
+// least link_match_minimum_response_fine, it is temporary, otherwise permanent.
+void forklift_s1_judge(Mapper * pMapper, LocalizedRangeScan * pScan, double runningResponse)
+{
+  if (!forklift::config().s1) {
+    return;
+  }
+  forklift::ScopedTimer timer("s1_judge");
+  forklift::S1State & st = forklift::s1_state();
+  st.keyframes++;
+  MapperSensorManager * pManager = pMapper->GetMapperSensorManager();
+  const Name & name = pScan->GetSensorName();
+  const Pose2 me = pScan->GetCorrectedPose();
+  std::vector<forklift::NearCandidate> candidates;
+  for (const auto & kv : pManager->GetScans(name)) {
+    LocalizedRangeScan * s = kv.second;
+    if (s == NULL || s == pScan) {
+      continue;
+    }
+    const Pose2 other = s->GetCorrectedPose();
+    const double dist = std::hypot(other.GetX() - me.GetX(), other.GetY() - me.GetY());
+    if (dist > 0.3) {
+      continue;
+    }
+    candidates.push_back({kv.first, dist, math::NormalizeAngle(other.GetHeading() - me.GetHeading()),
+        st.temporary.count(kv.first) == 0});
+  }
+  const int nearId = forklift::nearest_valid_permanent(candidates, 0.3, 0.35);
+  bool temporary = false;
+  if (nearId >= 0) {
+    LocalizedRangeScan * pNear = pManager->GetScan(name, nearId);
+    const LocalizedRangeScanVector & running = pManager->GetRunningScans(name);
+    double response = -1.0;
+    if (std::find(running.begin(), running.end(), pNear) != running.end()) {
+      response = runningResponse;  // the running scans are that node's chain: the sequential match's own response
+    } else {
+      forklift::ScopedTimer match_timer("s1_match");
+      forklift::add_count("s1_extra_matches", 1);
+      const LocalizedRangeScanVector chain = forklift_s1_chain(pMapper, pScan, nearId);
+      if (!chain.empty()) {
+        Pose2 mean;
+        Matrix3 cov;
+        response = pMapper->GetSequentialScanMatcher()->MatchScan(pScan, chain, mean, cov, false);
+      }
+    }
+    temporary = response > pMapper->getParamLinkMatchMinimumResponseFine() - KT_TOLERANCE;
+    forklift::set_value("s1_near_id", nearId);
+    forklift::set_value("s1_response", response);
+  }
+  if (temporary) {
+    st.temporary[pScan->GetStateId()] = forklift::S1Mark{st.keyframes};
+  }
+  forklift::add_count("s1_temporary", temporary ? 1 : 0);
+}
+
+// S1: the temporary nodes born at least B keyframes ago, in id order. A running, last or new scan waits for a later
+// keyframe. Deleting one that would disconnect its neighbours makes it permanent instead.
+void forklift_s1_delete(Mapper * pMapper, LocalizedRangeScan * pScan)
+{
+  if (!forklift::config().s1) {
+    return;
+  }
+  forklift::ScopedTimer timer("s1_delete");
+  forklift::S1State & st = forklift::s1_state();
+  MapperSensorManager * pManager = pMapper->GetMapperSensorManager();
+  const Name & name = pScan->GetSensorName();
+  LocalizedRangeScanVector & running = pManager->GetRunningScans(name);
+  LocalizedRangeScan * pLast = pManager->GetLastScan(name);
+  const auto & vertices = pMapper->GetGraph()->GetVertices();
+  auto byName = vertices.find(name);
+  auto vertex = [&](int id) -> Vertex<LocalizedRangeScan> * {
+      if (byName == vertices.end()) {
+        return NULL;
+      }
+      auto found = byName->second.find(id);
+      return found == byName->second.end() ? NULL : found->second;
+    };
+  auto ids = [](const std::vector<Vertex<LocalizedRangeScan> *> & adjacent) {
+      std::vector<int> out;
+      for (Vertex<LocalizedRangeScan> * v : adjacent) {
+        out.push_back(v->GetObject()->GetStateId());
+      }
+      return out;
+    };
+  for (int id : forklift::s1_due(st.temporary, st.keyframes, forklift::config().s1_buffer)) {
+    LocalizedRangeScan * pVictim = pManager->GetScan(name, id);
+    if (pVictim == NULL) {
+      st.temporary.erase(id);  // gone already (never expected): drop its mark
+      forklift::add_count("s1_mark_without_scan", 1);
+      continue;
+    }
+    if (pVictim == pScan || pVictim == pLast || std::find(running.begin(), running.end(), pVictim) != running.end()) {
+      continue;  // still in use; looked at again after a later keyframe
+    }
+    Vertex<LocalizedRangeScan> * pVertex = vertex(id);
+    const std::vector<int> neighbours = pVertex == NULL ? std::vector<int>() : ids(pVertex->GetAdjacentVertices());
+    const bool connected = forklift::still_connected(id, neighbours, [&](int at) {
+          Vertex<LocalizedRangeScan> * v = vertex(at);
+          return v == NULL ? std::vector<int>() : ids(v->GetAdjacentVertices());
+        });
+    st.temporary.erase(id);
+    if (!connected) {
+      st.promoted++;
+      forklift::add_count("s1_promoted", 1);
+      std::fprintf(stderr, "forklift_slam_patch s1 promoted id=%d reason=disconnects\n", id);
+      continue;
+    }
+    if (forklift_delete_node(pMapper, pVictim)) {
+      st.deleted++;
+      forklift::add_count("s1_deleted", 1);
+    } else {
+      forklift::add_count("delete_failed", 1);
+    }
+  }
+  std::int64_t live = 0;
+  for (const auto & kv : pManager->GetScans(name)) {
+    live += kv.second != NULL;
+  }
+  forklift::add_count("s1_temporary_nodes", static_cast<std::int64_t>(st.temporary.size()));
+  forklift::add_count("s1_permanent_nodes", live - static_cast<std::int64_t>(st.temporary.size()));
+  forklift::add_count("s1_promoted_total", st.promoted);
+  forklift::add_count("s1_deleted_total", st.deleted);
+}
