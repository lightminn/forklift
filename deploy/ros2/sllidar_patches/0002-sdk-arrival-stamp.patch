diff --git a/sdk/src/forklift_arrival.h b/sdk/src/forklift_arrival.h
new file mode 100644
index 0000000..6279880
--- /dev/null
+++ b/sdk/src/forklift_arrival.h
@@ -0,0 +1,133 @@
+/*
+ * forklift patch 0002 (7a-3, docs/plans/2026-11-26-7a3-sdk-arrival-stamp.md 2): sample times from the receive
+ * thread's byte arrival.
+ *
+ * - RxLog: the bench's receive record, only when FORKLIFT_SDK_RX_LOG names a file. Lines are queued (at most
+ *   RxLog::CAPACITY waiting) and written by a thread of its own every 200 ms, so neither the receive nor the decoder
+ *   thread ever waits on the file; a line that finds the queue full is counted, and the count is written ("D <n>")
+ *   with every flush and at the end.
+ *     R <rx_seq> <rx_us> <bytes> <decode_us>   one read: its number, arrival, size, and when the decoder took it
+ *     C <rx_seq> <capsule_seq> <ans_type>       one sample message completed by that read
+ * - deliverDecoded: the driver's (and the SDK test's) one way to hand a decoded message to the unpacker with the
+ *   arrival of the read that completed it.
+ */
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace sl { namespace internal { namespace forklift {
+
+class RxLog {
+public:
+    static const size_t CAPACITY = 1u << 16;
+
+    static RxLog& instance()
+    {
+        static RxLog log;
+        return log;
+    }
+
+    bool enabled() const { return _file != nullptr; }
+
+    void line(const char* fmt, unsigned long long a, unsigned long long b, unsigned long long c,
+              unsigned long long d = 0, bool four = false)
+    {
+        if (!_file) return;
+        char buf[128];
+        if (four) std::snprintf(buf, sizeof(buf), fmt, a, b, c, d);
+        else std::snprintf(buf, sizeof(buf), fmt, a, b, c);
+        std::lock_guard<std::mutex> l(_lock);
+        if (_pending.size() >= CAPACITY) {
+            ++_dropped;
+            return;
+        }
+        _pending.emplace_back(buf);
+    }
+
+    ~RxLog()
+    {
+        if (!_file) return;
+        {
+            std::lock_guard<std::mutex> l(_lock);
+            _stop = true;
+        }
+        _wake.notify_all();
+        if (_writer.joinable()) _writer.join();
+        _flush();
+        std::fclose(_file);
+    }
+
+private:
+    RxLog()
+    {
+        const char* path = std::getenv("FORKLIFT_SDK_RX_LOG");
+        if (path && *path) {
+            _file = std::fopen(path, "w");
+            if (_file) _writer = std::thread([this] { _run(); });
+        }
+    }
+
+    void _run()
+    {
+        std::unique_lock<std::mutex> l(_lock);
+        while (!_stop) {
+            _wake.wait_for(l, std::chrono::milliseconds(200));
+            l.unlock();
+            _flush();
+            l.lock();
+        }
+    }
+
+    void _flush()
+    {
+        std::vector<std::string> out;
+        unsigned long long dropped;
+        {
+            std::lock_guard<std::mutex> l(_lock);
+            out.swap(_pending);
+            dropped = _dropped;
+        }
+        for (const auto& s : out) {
+            std::fputs(s.c_str(), _file);
+            std::fputc('\n', _file);
+        }
+        std::fprintf(_file, "D %llu\n", dropped);
+        std::fflush(_file);
+    }
+
+    std::FILE* _file = nullptr;
+    std::mutex _lock;
+    std::condition_variable _wake;
+    std::vector<std::string> _pending;
+    unsigned long long _dropped = 0;
+    bool _stop = false;
+    std::thread _writer;
+};
+
+// The decoded message to the unpacker, with the arrival of the read that completed it (the codec holds it while it
+// decodes that read). True when the unpacker took it as sample data.
+template <class Codec, class Unpacker, class Message>
+bool deliverDecoded(Codec& codec, Unpacker& unpacker, const Message& msg, unsigned long long& capsule_seq)
+{
+    unsigned long long rx_us = 0, rx_seq = 0;
+    const bool arrival = codec.currentArrival(rx_us, rx_seq);
+    unpacker.setArrival(arrival, rx_us);
+    Message copy(msg);
+    const bool taken = unpacker.onSampleData(copy.cmd, copy.getDataBuf(), copy.getPayloadSize());
+    unpacker.setArrival(false, 0);
+    if (taken) {
+        ++capsule_seq;
+        RxLog::instance().line("C %llu %llu %llu", rx_seq, capsule_seq, (unsigned long long)copy.cmd);
+    }
+    return taken;
+}
+
+}}}  // namespace sl::internal::forklift
