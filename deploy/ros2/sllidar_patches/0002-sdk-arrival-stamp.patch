+// forklift patch 0002
+void RPLidarProtocolCodec::onDecodeDataAt(const void* buffer, size_t size, _u64 rx_us, _u64 rx_seq)
+{
+    _arrival_valid = true;
+    _arrival_us = rx_us;
+    _arrival_seq = rx_seq;
