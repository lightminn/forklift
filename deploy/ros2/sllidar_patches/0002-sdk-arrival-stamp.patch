diff --git a/test/forklift_arrival_test.cpp b/test/forklift_arrival_test.cpp
new file mode 100644
index 0000000..f5a515c
--- /dev/null
+++ b/test/forklift_arrival_test.cpp
@@ -0,0 +1,414 @@
+// forklift patch 0002 (7a-3, docs/plans/2026-11-26-7a3-sdk-arrival-stamp.md 6): the SDK's sample times come from
+// the receive thread's byte arrival. The real AsyncTransceiver, RPLidarProtocolCodec, the driver's delivery
+// (forklift::deliverDecoded) and the unpacker's Dense / UltraDense handlers, fed by a fake channel that releases
+// known bytes at known times (reads 80 ms apart) while the decoder is held 500 ms.
+//
+// What this proves: each sample's time is the arrival of the read that completed its own capsule (minus the mode's
+// sample delay), across a capsule split over two reads, several capsules in one read, an angle jump and a reset; the
+// path without an arrival marks the start. It does not prove the absolute error of the arrival itself (the bench).
+#include "sdkcommon.h"
+#include "hal/abs_rxtx.h"
+#include "hal/thread.h"
+#include "hal/types.h"
+#include "hal/assert.h"
+#include "hal/locker.h"
+#include "hal/socket.h"
+#include "hal/event.h"
+#include "hal/waiter.h"
+#include "hal/byteorder.h"
+#include "sl_lidar_driver.h"
+#include "dataunpacker/dataunpacker.h"
+#include "sl_async_transceiver.h"
+#include "sl_lidarprotocol_codec.h"
+#include "forklift_arrival.h"
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+using namespace sl;
+using namespace sl::internal;
+
+static int g_failed = 0;
+#define CHECK(cond, ...)                                                    \
+    do {                                                                    \
+        if (!(cond)) {                                                      \
+            ++g_failed;                                                     \
+            std::printf("FAIL %s:%d %s -- ", __FILE__, __LINE__, #cond);    \
+            std::printf(__VA_ARGS__);                                       \
+            std::printf("\n");                                              \
+        }                                                                   \
+    } while (0)
+
+static const _u64 MS = 1000;
+static const _u64 READ_GAP_US = 80 * MS;  // reads this far apart: one read's time is never taken for another's
+static const _u64 HOLD_US = 500 * MS;     // the decoder held this long before its first decode
+
+// --- the fake channel: chunks released at their times, each read's return time kept --------------------------------
+class FakeChannel : public IChannel {
+public:
+    struct Chunk { std::vector<_u8> bytes; _u64 at_us; _u64 read_us = 0; };
+    std::vector<Chunk> chunks;
+    size_t next = 0;
+    std::mutex lock;
+
+    bool open() override { return true; }
+    void close() override {}
+    void flush() override {}
+    bool waitForData(size_t, sl_u32, size_t*) override { return false; }
+    sl_result waitForDataExt(size_t& hint, sl_u32 timeoutInMs) override
+    {
+        hint = 0;
+        _u64 at;
+        {
+            std::lock_guard<std::mutex> l(lock);
+            if (next >= chunks.size()) {
+                std::this_thread::sleep_for(std::chrono::milliseconds(std::min<sl_u32>(timeoutInMs, 10)));
+                return SL_RESULT_OPERATION_TIMEOUT;
+            }
+            at = chunks[next].at_us;
+        }
+        _u64 now = getus();
+        if (now < at) std::this_thread::sleep_for(std::chrono::microseconds(at - now));
+        std::lock_guard<std::mutex> l(lock);
+        hint = chunks[next].bytes.size();
+        return SL_RESULT_OK;
+    }
+    int write(const void*, size_t size) override { return (int)size; }
+    int read(void* buffer, size_t size) override
+    {
+        std::lock_guard<std::mutex> l(lock);
+        Chunk& c = chunks[next++];
+        size_t n = std::min(size, c.bytes.size());
+        std::memcpy(buffer, c.bytes.data(), n);
+        c.read_us = getus();  // the read returns now: the receive thread stamps right after
+        return (int)n;
+    }
+    void clearReadCache() override {}
+    int getChannelType() override { return CHANNEL_TYPE_SERIALPORT; }
+};
+
+// --- the codec under test, its first decode held ----------------------------------------------------------------------
+class HeldCodec : public RPLidarProtocolCodec {
+public:
+    bool hold = true;
+    bool with_arrival = true;  // false: decode as the unpatched path does (the clock at decode time)
+    void onDecodeDataAt(const void* buffer, size_t size, _u64 rx_us, _u64 rx_seq) override
+    {
+        if (hold) {
+            hold = false;
+            std::this_thread::sleep_for(std::chrono::microseconds(HOLD_US));
+        }
+        if (with_arrival) RPLidarProtocolCodec::onDecodeDataAt(buffer, size, rx_us, rx_seq);
+        else onDecodeData(buffer, size);
+    }
+};
+
+// --- the driver's role: decoded messages to the unpacker, samples recorded ------------------------------------------
+struct Sample { _u64 ts; int tag; bool exact; _u64 wall; };
+
+class Sink : public IProtocolMessageListener, public LIDARSampleDataListener {
+public:
+    HeldCodec& codec;
+    LIDARSampleDataUnpacker* unpacker;
+    std::mutex lock;
+    std::vector<Sample> samples;
+    int ultra = 0;
+    int block_first_ms = 0;  // the first published sample's callback held this long (a restart test)
+    std::atomic<bool> in_callback{false};
+    std::atomic<_u64> callback_end{0};
+
+    Sink(HeldCodec& c, bool ultra_dense) : codec(c), ultra(ultra_dense)
+    {
+        unpacker = LIDARSampleDataUnpacker::CreateInstance(*this);
+        SlamtecLidarTimingDesc t;
+        t.sample_duration_uS = 31;
+        t.native_baudrate = 256000;
+        t.linkage_delay_uS = 0;
+        t.native_interface_type = LIDARInterfaceType::LIDAR_INTERFACE_UART;
+        t.native_timestamp_support = false;
+        unpacker->updateUnpackerContext(LIDARSampleDataUnpacker::UNPACKER_CONTEXT_TYPE_LIDAR_TIMING, &t, sizeof(t));
+        unpacker->enable();
+    }
+    ~Sink() { LIDARSampleDataUnpacker::ReleaseInstance(unpacker); }
+
+    void onProtocolMessageDecoded(const ProtocolMessage& msg) override
+    {
+        ProtocolMessage copy(msg);
+        forklift::deliverDecoded(codec, *unpacker, copy.cmd, copy.getDataBuf(), copy.getPayloadSize());
+    }
+    void onHQNodeScanResetReq() override {}
+    void onHQNodeDecoded(_u64 ts, const rplidar_response_measurement_node_hq_t* node) override
+    {
+        if (block_first_ms > 0) {
+            const int ms = block_first_ms;
+            block_first_ms = 0;
+            in_callback = true;
+            std::this_thread::sleep_for(std::chrono::milliseconds(ms));
+            callback_end = getus();
+        }
+        std::lock_guard<std::mutex> l(lock);
+        // the capsule's tag, from its distance (see capsule())
+        int tag = ultra ? (int)(node->dist_mm_q2 / 8) : (int)(node->dist_mm_q2 >> 2);
+        samples.push_back({ts, tag, unpacker->publishingExact(), getus()});
+    }
+};
+
+// --- bytes -------------------------------------------------------------------------------------------------------------
+static std::vector<_u8> descriptor(bool ultra)
+{
+    _u32 len = ultra ? sizeof(rplidar_response_ultra_dense_capsule_measurement_nodes_t)
+                     : sizeof(rplidar_response_dense_capsule_measurement_nodes_t);
+    _u32 word = len | ((_u32)RPLIDAR_ANS_PKTFLAG_LOOP << RPLIDAR_ANS_HEADER_SUBTYPE_SHIFT);
+    _u8 type = ultra ? RPLIDAR_ANS_TYPE_MEASUREMENT_ULTRA_DENSE_CAPSULED : RPLIDAR_ANS_TYPE_MEASUREMENT_DENSE_CAPSULED;
+    return {RPLIDAR_ANS_SYNC_BYTE1, RPLIDAR_ANS_SYNC_BYTE2, (_u8)(word & 0xFF), (_u8)((word >> 8) & 0xFF),
+            (_u8)((word >> 16) & 0xFF), (_u8)(word >> 24), type};
+}
+
+// one capsule starting at angle_deg whose every sample carries the distance tag (Dense: the distance; UltraDense:
+// scale 0, so dist_q2 = tag * 8)
+static std::vector<_u8> capsule(bool ultra, int angle_deg, int tag)
+{
+    std::vector<_u8> b;
+    if (ultra) {
+        rplidar_response_ultra_dense_capsule_measurement_nodes_t c;
+        std::memset(&c, 0, sizeof(c));
+        c.start_angle_sync_q6 = (_u16)(angle_deg * 64);
+        for (auto& cab : c.cabins) {
+            cab.qualityl_distance_scale[0] = (_u16)(tag << 2);
+            cab.qualityl_distance_scale[1] = (_u16)(tag << 2);
+            cab.qualityh_array = 0;
+        }
+        b.assign(reinterpret_cast<_u8*>(&c), reinterpret_cast<_u8*>(&c) + sizeof(c));
+    } else {
+        rplidar_response_dense_capsule_measurement_nodes_t c;
+        std::memset(&c, 0, sizeof(c));
+        c.start_angle_sync_q6 = (_u16)(angle_deg * 64);
+        for (auto& cab : c.cabins) cab.distance = (_u16)tag;
+        b.assign(reinterpret_cast<_u8*>(&c), reinterpret_cast<_u8*>(&c) + sizeof(c));
+    }
+    _u8 cs = 0;
+    for (size_t i = 2; i < b.size(); ++i) cs ^= b[i];
+    b[0] = (_u8)((RPLIDAR_RESP_MEASUREMENT_EXP_SYNC_1 << 4) | (cs & 0xF));
+    b[1] = (_u8)((RPLIDAR_RESP_MEASUREMENT_EXP_SYNC_2 << 4) | (cs >> 4));
+    return b;
+}
+
+static std::vector<_u8> cat(std::initializer_list<std::vector<_u8>> parts)
+{
+    std::vector<_u8> out;
+    for (const auto& p : parts) out.insert(out.end(), p.begin(), p.end());
+    return out;
+}
+
+static std::vector<_u8> slice(const std::vector<_u8>& v, size_t a, size_t b) { return {v.begin() + a, v.begin() + b}; }
+
+// --- one run -----------------------------------------------------------------------------------------------------------
+struct Run {
+    FakeChannel ch;
+    HeldCodec codec;
+    std::unique_ptr<Sink> sink;
+    std::unique_ptr<AsyncTransceiver> rx;
+    _u64 t0;
+
+    Run(bool ultra, std::vector<std::vector<_u8>> reads, bool hold = true, bool with_arrival = true)
+    {
+        codec.hold = hold;
+        codec.with_arrival = with_arrival;
+        sink.reset(new Sink(codec, ultra));
+        codec.setMessageListener(sink.get());
+        t0 = getus() + 50 * MS;
+        for (size_t k = 0; k < reads.size(); ++k) ch.chunks.push_back({reads[k], t0 + k * READ_GAP_US});
+        rx.reset(new AsyncTransceiver(codec));
+    }
+    void go(_u64 extra_us = 0)
+    {
+        rx->openChannelAndBind(&ch);
+        _u64 end = t0 + ch.chunks.size() * READ_GAP_US + (codec.hold ? HOLD_US : 0) + 200 * MS + extra_us;
+        while (getus() < end) std::this_thread::sleep_for(std::chrono::milliseconds(5));
+    }
+    void stop()
+    {
+        rx->unbindAndClose();
+        codec.setMessageListener(nullptr);
+    }
+    _u64 read_us(size_t k) { return ch.chunks[k].read_us; }
+    // every sample of capsule `tag`: within [read - 30 ms, read + 10 ms] of read k (the mode's sample delay is a few ms)
+    // ... each exact, and the capsule's samples one sample duration (31 us) apart in order, all of them (the mode's
+    // grouping delay, Codex 7a-3b round 1 P3: UltraDense's 64 samples a capsule)
+    void expect(int tag, size_t k, const char* what)
+    {
+        std::lock_guard<std::mutex> l(sink->lock);
+        std::vector<_u64> ts;
+        for (const auto& s : sink->samples) {
+            if (s.tag != tag) continue;
+            ts.push_back(s.ts);
+            long long d = (long long)s.ts - (long long)read_us(k);
+            CHECK(d >= -30000 && d <= 10000, "%s: capsule %d sample %lld us from read %zu", what, tag, d, k);
+            CHECK(s.exact, "%s: capsule %d sample not exact", what, tag);
+        }
+        const size_t per = sink->ultra ? 64 : 40;
+        CHECK(ts.size() == per, "%s: capsule %d gave %zu samples, not %zu", what, tag, ts.size(), per);
+        for (size_t i = 1; i < ts.size(); ++i)
+            CHECK(ts[i] - ts[i - 1] == 31, "%s: capsule %d samples %zu-%zu %lld us apart", what, tag, i - 1, i,
+                  (long long)ts[i] - (long long)ts[i - 1]);
+    }
+    int count(int tag)
+    {
+        std::lock_guard<std::mutex> l(sink->lock);
+        int n = 0;
+        for (const auto& s : sink->samples) n += s.tag == tag;
+        return n;
+    }
+};
+
+// A capsule split over two reads, three capsules completed by one read, Dense's previous capsule.
+static void test_own_capsule_arrival(bool ultra)
+{
+    const char* what = ultra ? "ultra_dense own capsule" : "dense own capsule";
+    auto c1 = capsule(ultra, 9, 110), c2 = capsule(ultra, 18, 120), c3 = capsule(ultra, 27, 130);
+    auto c4 = capsule(ultra, 36, 140), c5 = capsule(ultra, 45, 150);
+    Run r(ultra, {descriptor(ultra), slice(c1, 0, 50), cat({slice(c1, 50, c1.size()), c2, slice(c3, 0, 10)}),
+                  cat({slice(c3, 10, c3.size()), c4}), c5});
+    r.go();
+    r.stop();
+    r.expect(110, 2, what);  // completed by read 2 (its second part)
+    r.expect(120, 2, what);  // completed by read 2 too
+    r.expect(130, 3, what);
+    r.expect(140, 3, what);  // published when c5 came (read 4): unpatched Dense would take read 4's time
+    // the decoder ran after HOLD_US: the arrival, not the decode, is what the samples carry
+    CHECK(r.read_us(4) + 100 * MS < r.t0 + HOLD_US, "%s: the reads did not all come before the decode", what);
+}
+
+// The unpatched path (no arrival): the same stream is stamped at decode time -- the delay patch 0002 removes, and the
+// start marked (arrival_ok false in the node).
+static void test_without_arrival_is_late_and_marked()
+{
+    auto c1 = capsule(false, 9, 110), c2 = capsule(false, 18, 120);
+    Run r(false, {descriptor(false), c1, c2}, true, false);
+    r.go();
+    r.stop();
+    std::lock_guard<std::mutex> l(r.sink->lock);
+    CHECK(!r.sink->samples.empty(), "control: no sample");
+    for (const auto& s : r.sink->samples) {
+        long long late = (long long)s.ts - (long long)r.read_us(2);
+        CHECK(late > (long long)(HOLD_US - 250 * MS), "control: sample only %lld us after its read", late);
+        CHECK(!s.exact, "control: a clock time called exact");
+    }
+    if (!r.sink->samples.empty())
+        std::printf("control (decode-time clock, as patch 0001 alone): %lld ms after the read\n",
+                    ((long long)r.sink->samples[0].ts - (long long)r.read_us(2)) / 1000);
+}
+
+// An angle jump discards the previous capsule and keeps the jumping one -- with its own time.
+static void test_angle_jump_keeps_its_own_time(bool ultra)
+{
+    const char* what = ultra ? "ultra_dense angle jump" : "dense angle jump";
+    auto c1 = capsule(ultra, 9, 110), c2 = capsule(ultra, 18, 120), c3 = capsule(ultra, 230, 130);
+    auto c4 = capsule(ultra, 239, 140), c5 = capsule(ultra, 248, 150);
+    Run r(ultra, {descriptor(ultra), c1, c2, c3, c4, c5}, false);
+    r.go();
+    r.stop();
+    r.expect(110, 1, what);
+    CHECK(r.count(120) == 0, "%s: the capsule before the jump was published", what);
+    r.expect(130, 3, what);  // the jumping capsule, published when c4 came: its own read, never read 4's
+    r.expect(140, 4, what);
+}
+
+// A reset drops the previous capsule and its time: nothing of it is published after.
+static void test_reset_drops_the_previous_capsule(bool ultra)
+{
+    const char* what = ultra ? "ultra_dense reset" : "dense reset";
+    auto c1 = capsule(ultra, 9, 110), c2 = capsule(ultra, 18, 120);
+    auto c3 = capsule(ultra, 90, 130), c4 = capsule(ultra, 99, 140);
+    Run r(ultra, {descriptor(ultra), c1, c2, c3, c4}, false);
+    // the reset halfway between reads 2 and 3, the decoder idle (as a scan restart between capsules)
+    r.rx->openChannelAndBind(&r.ch);
+    _u64 at = r.t0 + 2 * READ_GAP_US + READ_GAP_US / 2;
+    while (getus() < at) std::this_thread::sleep_for(std::chrono::milliseconds(2));
+    r.sink->unpacker->reset();
+    _u64 end = r.t0 + r.ch.chunks.size() * READ_GAP_US + 200 * MS;
+    while (getus() < end) std::this_thread::sleep_for(std::chrono::milliseconds(5));
+    r.stop();
+    r.expect(110, 1, what);
+    CHECK(r.count(120) == 0, "%s: the capsule before the reset was published after it", what);
+    r.expect(130, 3, what);
+}
+
+// A byte lost on the line: the handler resyncs and its capsules now end inside the codec's blocks -- completed by an
+// earlier read than the one the block's callback runs on. Those samples are never called exact (round 1 P2-1).
+static void test_a_resync_is_never_exact(bool ultra)
+{
+    const char* what = ultra ? "ultra_dense resync" : "dense resync";
+    auto c1 = capsule(ultra, 9, 110), c2 = capsule(ultra, 18, 120), c3 = capsule(ultra, 27, 130);
+    auto c4 = capsule(ultra, 36, 140), c5 = capsule(ultra, 45, 150), c6 = capsule(ultra, 54, 160);
+    auto c7 = capsule(ultra, 63, 170);
+    Run r(ultra, {descriptor(ultra), c1, slice(c2, 0, c2.size() - 1), c3, c4, c5, c6, c7}, false);
+    r.go();
+    r.stop();
+    std::lock_guard<std::mutex> l(r.sink->lock);
+    int inexact = 0;
+    for (const auto& s : r.sink->samples) {
+        if (s.tag >= 140) {
+            CHECK(!s.exact, "%s: capsule %d after the lost byte called exact", what, s.tag);
+        }
+        inexact += !s.exact;
+    }
+    CHECK(inexact > 0, "%s: no sample marked inexact", what);
+}
+
+// A scan restart (disable / enable on the control thread) while a decode is inside a sample callback: disable waits
+// for the decode, and nothing of the capsule cached before it is published after the restart (round 1 P2-2).
+static void test_a_restart_waits_for_the_decode_in_progress()
+{
+    auto c1 = capsule(false, 9, 110), c2 = capsule(false, 18, 120), c3 = capsule(false, 27, 130);
+    auto c4 = capsule(false, 36, 140), c5 = capsule(false, 45, 150), c6 = capsule(false, 54, 160);
+    auto c7 = capsule(false, 63, 170), c8 = capsule(false, 72, 180), c9 = capsule(false, 81, 190);
+    // c6..c9 arrive after the restart (reads 6..9, from 480 ms on): whatever was queued during the held callback
+    Run r(false, {descriptor(false), c1, c2, c3, c4, c5, c6, c7, c8, c9}, false);
+    r.sink->block_first_ms = 300;  // c1's first sample, published while c2 is decoded
+    r.rx->openChannelAndBind(&r.ch);
+    while (!r.sink->in_callback) std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    r.sink->unpacker->disable();
+    const _u64 disabled = getus();
+    CHECK(r.sink->callback_end != 0 && disabled >= r.sink->callback_end,
+          "restart: disable returned during the decode");
+    r.sink->unpacker->enable();
+    const _u64 enabled = getus();
+    _u64 end = r.t0 + r.ch.chunks.size() * READ_GAP_US + 500 * MS;
+    while (getus() < end) std::this_thread::sleep_for(std::chrono::milliseconds(5));
+    r.stop();
+    std::lock_guard<std::mutex> l(r.sink->lock);
+    int later = 0;
+    for (const auto& s : r.sink->samples) {
+        CHECK(!(s.tag == 120 && s.wall > enabled), "restart: the capsule cached before the restart published after it");
+        later += s.wall > enabled && s.tag >= 130;
+    }
+    CHECK(later > 0, "restart: nothing published after the restart");
+}
+
+int main()
+{
+    test_own_capsule_arrival(false);
+    test_own_capsule_arrival(true);
+    test_without_arrival_is_late_and_marked();
+    test_angle_jump_keeps_its_own_time(false);
+    test_angle_jump_keeps_its_own_time(true);
+    test_reset_drops_the_previous_capsule(false);
+    test_reset_drops_the_previous_capsule(true);
+    test_a_resync_is_never_exact(false);
+    test_a_resync_is_never_exact(true);
+    test_a_restart_waits_for_the_decode_in_progress();
+    if (g_failed) {
+        std::printf("%d check(s) failed\n", g_failed);
+        return 1;
+    }
+    std::printf("forklift_arrival_test: all checks passed\n");
+    return 0;
+}
